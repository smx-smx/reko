<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(ProjectDir)../../Drivers/CommonBuildProperties.items" />
  <PropertyGroup>
    <ProjectGuid>{02595A47-2592-441D-B44D-8EA8C19EE5E2}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>Reko.ImageLoaders.Coff</RootNamespace>
    <AssemblyName>Reko.ImageLoaders.Coff</AssemblyName>
    <TargetFramework>netstandard2.1</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="KaitaiStruct.Runtime.CSharp" Version="0.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Core.csproj" />
  </ItemGroup>

  <Target Name="GenerateCsFiles" BeforeTargets="CoreCompile">
    <ItemGroup>
      <KsyFiles Include="ksy\ecoff.ksy" />
    </ItemGroup>

    <PropertyGroup>
      <KsyOutputDir>$(ProjectDir.TrimEnd('\'))</KsyOutputDir>
      <KsyFileList>@(KsyFiles -> '%(FullPath)', ';')</KsyFileList>
      <KsyNamespace>$(RootNamespace).Kaitai</KsyNamespace>
    </PropertyGroup>

    <MSBuild Projects="$(ProjectDir)..\..\BuildTargets\BuildTargets.csproj" Properties="Configuration=$(Configuration);Platform=$(Platform);KsyFileList=$(KsyFileList);KsyOutputDir=$(KsyOutputDir);KsyNamespace=$(KsyNamespace)" Targets="gen_kaitai_files" />
  </Target>
</Project>